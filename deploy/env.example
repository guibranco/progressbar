# Copy to deploy/env (docker compose) or /etc/progressbar/env (systemd).
# All values are optional; the defaults are shown.

# Cache-Control max-age for /<n>/ badges (pure function of the URL).
# Default 604800 (7 days), max 2592000 (30 days).
PROGRESSBAR_STATIC_CACHE_SECONDS=604800

# Default Cache-Control max-age for /dynamic/json/ (overridable per request
# with ?cache=<seconds>, 0 disables). Max 86400.
PROGRESSBAR_DYNAMIC_CACHE_SECONDS=300

# gunicorn sizing (2 x 8 is fine for a 1 vCPU / 1 GB VM).
PROGRESSBAR_WORKERS=2
PROGRESSBAR_THREADS=8

# gunicorn logging: "warning" | "info" | "debug"; set PROGRESSBAR_ACCESS_LOG=-
# to also write an access log to stdout (NGINX already logs every request).
PROGRESSBAR_LOG_LEVEL=warning
#PROGRESSBAR_ACCESS_LOG=-
